# Copy to node-app/.env for running the Node app OUTSIDE Docker.
# When run via docker-compose, values come from ../ .env / compose environment.

ASTERISK_HOST=127.0.0.1

ARI_URL=http://127.0.0.1:8088
ARI_USER=ariuser
ARI_PASSWORD=
ARI_APP_NAME=node-stasis-app

AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=amiuser
AMI_PASSWORD=

SIP_EXTENSION=1000
PORT=3000

# Twilio (mirrors from root .env). Only values used by Node are listed here.
TWILIO_DID=
TWILIO_VERIFIED_NUMBERS=

# Inbound greeting sound URI (no extension).
INBOUND_GREETING_SOUND=custom/greeting
