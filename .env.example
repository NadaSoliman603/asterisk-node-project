# Copy to .env and fill in real values. Do NOT commit .env.

ASTERISK_IMAGE=andrius/asterisk:latest

EXTERNAL_MEDIA_ADDRESS=127.0.0.1
EXTERNAL_SIGNALING_ADDRESS=127.0.0.1

SIP_EXTENSION=1000
SIP_PASSWORD=

AMI_USER=amiuser
AMI_PASSWORD=
AMI_PORT=5038

ARI_USER=ariuser
ARI_PASSWORD=
ARI_HTTP_PORT=8088
ARI_APP_NAME=node-stasis-app

NODE_APP_PORT=3000

# --- Twilio Elastic SIP Trunk ---
TWILIO_TRUNK_SID=
TWILIO_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
TWILIO_DID=
PUBLIC_SIP_DOMAIN=
# Comma-separated E.164 numbers permitted for outbound (trial safety).
TWILIO_VERIFIED_NUMBERS=

# Sound URI played to inbound Twilio callers (no file extension).
# Files live in sounds/custom/ on the host.
INBOUND_GREETING_SOUND=custom/greeting

# --- AI voice bridge (Phase 3+) ---
# Empty / unset  → play INBOUND_GREETING_SOUND (default, unchanged behaviour)
# 'echo'         → RTP loopback through aiVoiceBridge (Phase 3 plumbing test)
# 'true'         → full OpenAI Realtime AI (Phase 4, not built yet)
AI_VOICE_ENABLED=
# Hostname Asterisk uses to send RTP to node-app. Inside compose, use the
# service name (default). Override when running node-app outside compose.
AI_MEDIA_HOSTNAME=node-app
EXTERNAL_MEDIA_RTP_PORT_MIN=10500
EXTERNAL_MEDIA_RTP_PORT_MAX=10599

# --- OpenAI Realtime (Phase 2+) ---
# Required for /debug/tts and AI calls. Real OpenAI key — NOT the Gemini one.
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=alloy
# Playback speed multiplier for assistant audio (~0.25–1.5).
REALTIME_SPEED=1.1
# Transcription language hint for the user's spoken audio.
# 'ar' for Egyptian Arabic; '' = auto-detect (less accurate).
TRANSCRIBE_LANGUAGE=ar

# --- AI call guardrails (Phase 4) ---
# Hard hangup after this many seconds — protects against runaway costs.
AI_MAX_CALL_SECONDS=600
# Maximum function/tool invocations per single call.
AI_MAX_TOOL_CALLS_PER_CALL=10
# Optional: override the greeting the assistant speaks when the call connects.
# Wording is an INSTRUCTION to the model, not a script it says verbatim.
AI_GREETING_INSTRUCTION=
