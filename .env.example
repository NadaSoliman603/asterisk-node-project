# Copy to .env and fill in real values. Do NOT commit .env.

ASTERISK_IMAGE=andrius/asterisk:latest

EXTERNAL_MEDIA_ADDRESS=127.0.0.1
EXTERNAL_SIGNALING_ADDRESS=127.0.0.1

SIP_EXTENSION=1000
SIP_PASSWORD=

AMI_USER=amiuser
AMI_PASSWORD=
AMI_PORT=5038

ARI_USER=ariuser
ARI_PASSWORD=
ARI_HTTP_PORT=8088
ARI_APP_NAME=node-stasis-app

NODE_APP_PORT=3000

# --- Twilio Elastic SIP Trunk ---
TWILIO_TRUNK_SID=
TWILIO_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
TWILIO_DID=
PUBLIC_SIP_DOMAIN=
# Comma-separated E.164 numbers permitted for outbound (trial safety).
TWILIO_VERIFIED_NUMBERS=

# Sound URI played to inbound Twilio callers (no file extension).
# Files live in sounds/custom/ on the host.
INBOUND_GREETING_SOUND=custom/greeting
